{
  "name": "@octoc2/octoctl",
  "version": "0.1.0",
  "private": true,
  "description": "OctoC2 operator CLI for authorized systems research",
  "bin": {
    "octoctl": "dist/octoctl"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/octoctl",
    "test": "bun test src/__tests__",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "0.9.1",
    "@grpc/grpc-js": "1.14.4",
    "@octoc2/shared": "workspace:*",
    "@octokit/rest": "22.0.1",
    "chalk": "5.6.2",
    "commander": "12.1.0",
    "ink": "5.2.1",
    "libsodium-wrappers": "0.8.2",
    "ora": "8.2.0",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "bun-types": "1.3.11",
    "typescript": "5.9.3"
  }
}
