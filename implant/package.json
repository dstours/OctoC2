{
  "name": "@octoc2/implant",
  "version": "0.1.0",
  "private": true,
  "description": "OctoC2 beacon runtime for authorized systems research",
  "module": "src/index.ts",
  "main": "dist/beacon.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun run build:linux-x64",
    "build:linux-x64": "bun build src/index.ts --compile --minify --sourcemap=none --compile-exec-argv=\"--smol\" --target=bun-linux-x64 --external cpu-features --external \"*/sshcrypto.node\" --outfile dist/beacon-linux-x64",
    "build:linux-arm64": "bun build src/index.ts --compile --minify --sourcemap=none --compile-exec-argv=\"--smol\" --target=bun-linux-arm64 --external cpu-features --external \"*/sshcrypto.node\" --outfile dist/beacon-linux-arm64",
    "build:windows-x64": "bun build src/index.ts --compile --minify --sourcemap=none --compile-exec-argv=\"--smol\" --target=bun-windows-x64 --external cpu-features --external \"*/sshcrypto.node\" --outfile dist/beacon-windows-x64.exe",
    "build:darwin-arm64": "bun build src/index.ts --compile --minify --sourcemap=none --compile-exec-argv=\"--smol\" --target=bun-darwin-arm64 --external cpu-features --external \"*/sshcrypto.node\" --outfile dist/beacon-macos-arm64",
    "build:darwin-x64": "bun build src/index.ts --compile --minify --sourcemap=none --compile-exec-argv=\"--smol\" --target=bun-darwin-x64 --external cpu-features --external \"*/sshcrypto.node\" --outfile dist/beacon-macos-x64",
    "build:all": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:windows-x64 && bun run build:darwin-arm64 && bun run build:darwin-x64",
    "test": "bun test src/__tests__",
    "test:watch": "bun test --watch src/__tests__",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@octoc2/shared": "workspace:*",
    "@octokit/rest": "22.0.1",
    "jose": "6.2.2",
    "libsodium-wrappers": "0.8.2",
    "protobufjs": "8.7.1"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "0.8.2",
    "bun-types": "1.3.11",
    "typescript": "5.9.3"
  }
}
