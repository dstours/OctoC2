{
  "name": "@octoc2/shared",
  "version": "0.1.0",
  "private": true,
  "description": "OctoC2 protocol, identity, and signing primitives for authorized systems research",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tasks": {
      "types": "./src/tasks.ts",
      "import": "./src/tasks.ts"
    },
    "./channels": {
      "types": "./src/channels.ts",
      "import": "./src/channels.ts"
    },
    "./canonical": {
      "types": "./src/canonical.ts",
      "import": "./src/canonical.ts"
    },
    "./envelopes": {
      "types": "./src/envelopes.ts",
      "import": "./src/envelopes.ts"
    },
    "./proto": {
      "types": "./src/generated/svc-proto.ts",
      "import": "./src/generated/svc-proto.ts"
    },
    "./stego": {
      "types": "./src/stego.ts",
      "import": "./src/stego.ts"
    }
  },
  "scripts": {
    "test": "bun test src/__tests__",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "libsodium-wrappers": "0.8.2"
  },
  "devDependencies": {
    "bun-types": "1.3.11",
    "typescript": "5.9.3"
  }
}
