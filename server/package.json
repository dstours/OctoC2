{
  "name": "@octoc2/server",
  "version": "0.1.0",
  "private": true,
  "description": "OctoC2 durable controller for authorized systems research",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/svc-server",
    "test": "bun test src/__tests__",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@octoc2/shared": "workspace:*",
    "@octokit/rest": "22.0.1",
    "jose": "6.2.2",
    "libsodium-wrappers": "0.8.2"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "0.8.2",
    "@types/node": "22.19.15",
    "bun-types": "1.3.11",
    "typescript": "5.9.3"
  }
}
